# Copy this file to .env.local for local development, and set the same
# variable in Vercel → Project → Settings → Environment Variables.
#
# Get a key at https://console.anthropic.com → API Keys.
# Keep it secret. Never commit .env.local.

ANTHROPIC_API_KEY=sk-ant-your-key-here

